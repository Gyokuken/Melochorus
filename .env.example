# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local:   postgresql://USER:PASSWORD@localhost:5432/melochorus?schema=public
# Neon/Supabase: paste the pooled connection string they give you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/melochorus?schema=public"

# NextAuth — required.
# NEXTAUTH_URL is your app's base URL (use http://localhost:3000 in dev).
NEXTAUTH_URL="http://localhost:3000"
# Generate a secret:  npx auth secret   (or)   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth credentials (console.cloud.google.com -> Credentials -> OAuth client).
# Authorized redirect URI must be: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated list of admin emails. These accounts can open /host
# (the speaker view) and advance the queue. Use the Google account that
# will run the speaker machine.
ADMIN_EMAILS="you@example.com"
